<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PrintableBook</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintableBook.Core\PrintableBook.Core.csproj" />
    <ProjectReference Include="..\PrintableBook.Infrastructure\PrintableBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Frontend\**\*"
             Exclude="Frontend\node_modules\**;Frontend\package.json;Frontend\package-lock.json;Frontend\tailwind.config.js;Frontend\test-*.mjs;Frontend\verify-css.mjs;Frontend\css\input.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Metadata\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>

  <!-- Playwright resolves its Node driver from .playwright at runtime. Keep that
       payload beside the single-file executable instead of bundling it into it. -->
  <Target Name="ExcludePlaywrightDriverFromSingleFile" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             ExcludeFromSingleFile="true"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('.playwright\'))" />
    </ItemGroup>
  </Target>

</Project>
